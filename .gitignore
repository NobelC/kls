# ============================================================================
# kls — Complete Gitignore
# .gitignore
# ============================================================================
# Excludes files generated by compilation, builds, IDEs, and editors
# Updated for C++20 with CMake and clangd
# ============================================================================

# ----------------------------------------------------------------------------
# C++ Compilation Files
# ----------------------------------------------------------------------------
# Prerequisites
*.d

# Compiled object files
*.slo
*.lo
*.o
*.obj

# Precompiled headers
*.gch
*.pch

# Linker files
*.ilk

# Debugger files
*.pdb

# Compiled dynamic libraries
*.so
*.so.*
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Debug information files
*.dwo

# Core dumps
core
core.*

# ----------------------------------------------------------------------------
# Build Directories
# ----------------------------------------------------------------------------
# CMake build directories
build/
build-*/
cmake-build-*/
out/
bin/
lib/

# Binaries generated by kron
kron-basic
kron-standard
kron-complete

# ----------------------------------------------------------------------------
# CMake
# ----------------------------------------------------------------------------
CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake
_deps/

compile_commands.json

# CPack files
CPackConfig.cmake
CPackSourceConfig.cmake

# ----------------------------------------------------------------------------
# clangd (LSP)
# ----------------------------------------------------------------------------
.cache/
.clangd/
.clang-format
.clang-tidy

# ----------------------------------------------------------------------------
# Editors and IDEs
# ----------------------------------------------------------------------------

## Vim / Neovim
*.swp
*.swo
*~
.*.sw?
Session.vim
.netrwhist
tags
.vim/

## VSCode
.vscode/
*.code-workspace

## Visual Studio
.vs/
*.user
*.userosscache
*.sln.docstates
*.suo
*.tmp_proj
*.log
*.vspscc
*.vssscc
.builds/
*.pidb
*.svclog
*.scc

## CLion / IntelliJ IDEA
.idea/
cmake-build-*/
*.iml
*.iws

## Xcode
*.xcodeproj/
*.xcworkspace/
xcuserdata/

## Eclipse
.cproject
.project
.settings/

## Qt Creator
*.pro.user
*.pro.user.*

# ----------------------------------------------------------------------------
# Development Tools
# ----------------------------------------------------------------------------

## Valgrind
vgcore.*
*.valgrind
massif.out.*
callgrind.out.*

## gcov / lcov
*.gcno
*.gcda
*.gcov
coverage/
*.lcov

## gprof
gmon.out

## Sanitizers
*.san
*.asan
*.tsan
*.ubsan

## Profilers
perf.data
perf.data.old

# ----------------------------------------------------------------------------
# Testing
# ----------------------------------------------------------------------------
Testing/
test-results/
*.test
test_*.log

# GoogleTest
googletest-*/
gtest-*/

# Catch2
catch2-*/

# ----------------------------------------------------------------------------
# Generated Documentation
# ----------------------------------------------------------------------------
docs/html/
docs/latex/
docs/_build/
Doxyfile.bak
*.dox

# ----------------------------------------------------------------------------
# External Dependencies (if used)
# ----------------------------------------------------------------------------
third-party/
external/
vendor/
deps/

# Keep the directory if it contains a README
!third-party/README.md
!external/README.md
!vendor/README.md

# ----------------------------------------------------------------------------
# Operating System
# ----------------------------------------------------------------------------

## macOS
.DS_Store
.AppleDouble
.LSOverride
._*

## Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

## Linux
.directory
.Trash-*
.nfs*

# ----------------------------------------------------------------------------
# Temporary Files
# ----------------------------------------------------------------------------
*.tmp
*.temp
*.bak
*.backup
*.old
*~

# ----------------------------------------------------------------------------
# Logs
# ----------------------------------------------------------------------------
*.log
logs/
*.log.*

# ----------------------------------------------------------------------------
# Packaging
# ----------------------------------------------------------------------------
*.tar.gz
*.zip
*.7z
*.rar
*.deb
*.rpm

# ----------------------------------------------------------------------------
# Personal / Local Files
# ----------------------------------------------------------------------------
.env
.env.local
local.cmake
*.local

issues.sh

# Local release artifacts
kls-*.tar.gz
kls-*.tar.gz.asc

# Temporary extraction test directories
/kls-*/
