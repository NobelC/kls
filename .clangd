# ============================================================================
# kls — clangd Configuration
# .clangd corrected for C++20
# ============================================================================

CompileFlags:
  # Build directory where CMake generates compile_commands.json
  CompilationDatabase: build/
  
  # Compilation flags for static analysis
  Add:
    - "-std=c++20"
    - "-Iinclude"
    - "-Wall"
    - "-Wextra"
    - "-Wpedantic"
    - "-Wconversion"
    - "-Wsign-conversion"
    - "-Wshadow"
    - "-Wno-unused-parameter"
    - "-Wno-unused-variable"
    - "-Wno-sign-compare"

Diagnostics:
  # clang-tidy configuration for performance and modernization analysis
  ClangTidy:
    Add:
      - "modernize-*"
      - "performance-*"
      - "readability-identifier-naming"
      - "readability-braces-around-statements"
      - "bugprone-*"
    Remove:
      - "modernize-use-trailing-return-type"
      - "readability-magic-numbers"
      - "bugprone-easily-swappable-parameters"
      - "modernize-pass-by-value"

Index:
  # Background indexing for performance in large projects
  Background: Build
  StandardLibrary: true

Completion:
  # Includes symbols from all indexed files
  AllScopes: true
Hover:
  # Shows extended information about types and templates
  ShowAKA: true

InlayHints:
  # Visually displays parameter names in function calls
  ParameterNames: true
  # Displays deduced types for 'auto'
  DeducedTypes: true
  # Displays types in Structured Bindings
  Designators: true
