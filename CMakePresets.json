{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
        "ENABLE_SANITIZERS": "OFF",
        "ENABLE_TSAN": "OFF",
        "ENABLE_COVERAGE": "OFF",
        "BUILD_TESTING": "OFF"
      }
    },
    {
      "name": "gcc",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "/usr/bin/g++",
        "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=lld"
      }
    },
    {
      "name": "clang",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "/usr/bin/clang++",
        "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=lld"
      }
    },
    {
      "name": "gcc-debug",
      "displayName": "GCC Debug",
      "inherits": "gcc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "clang-debug",
      "displayName": "Clang Debug",
      "inherits": "clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "gcc-release",
      "displayName": "GCC Release",
      "inherits": "gcc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "clang-release",
      "displayName": "Clang Release",
      "inherits": "clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "clang-profile",
      "displayName": "Clang RelWithDebInfo",
      "inherits": "clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "clang-tests",
      "displayName": "Clang Debug + Tests",
      "inherits": "clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "CMAKE_C_COMPILER": "/usr/bin/clang",
        "CMAKE_C_COMPILER_LAUNCHER": "ccache"
      }
    },
    {
      "name": "clang-asan-ubsan",
      "displayName": "Clang ASan + UBSan",
      "inherits": "clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "ENABLE_SANITIZERS": "ON",
        "CMAKE_C_COMPILER": "/usr/bin/clang",
        "CMAKE_C_COMPILER_LAUNCHER": "ccache"
      }
    },
    {
      "name": "clang-tsan",
      "displayName": "Clang ThreadSanitizer",
      "inherits": "clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "ENABLE_TSAN": "ON",
        "CMAKE_C_COMPILER": "/usr/bin/clang",
        "CMAKE_C_COMPILER_LAUNCHER": "ccache"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "gcc-debug",
      "configurePreset": "gcc-debug"
    },
    {
      "name": "clang-debug",
      "configurePreset": "clang-debug"
    },
    {
      "name": "gcc-release",
      "configurePreset": "gcc-release"
    },
    {
      "name": "clang-release",
      "configurePreset": "clang-release"
    },
    {
      "name": "clang-profile",
      "configurePreset": "clang-profile"
    },
    {
      "name": "clang-tests",
      "configurePreset": "clang-tests"
    },
    {
      "name": "clang-asan-ubsan",
      "configurePreset": "clang-asan-ubsan"
    },
    {
      "name": "clang-tsan",
      "configurePreset": "clang-tsan"
    }
  ],
  "testPresets": [
    {
      "name": "clang-tests",
      "configurePreset": "clang-tests",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "stopOnFailure": true,
        "noTestsAction": "error"
      }
    },
    {
      "name": "clang-asan-ubsan",
      "configurePreset": "clang-asan-ubsan",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:strict_string_checks=1:check_initialization_order=1",
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "stopOnFailure": true,
        "noTestsAction": "error"
      }
    },
    {
      "name": "clang-tsan",
      "configurePreset": "clang-tsan",
      "environment": {
        "TSAN_OPTIONS": "halt_on_error=1:second_deadlock_stack=1"
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "stopOnFailure": true,
        "noTestsAction": "error"
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "check",
      "displayName": "Configure, build and test",
      "steps": [
        {
          "type": "configure",
          "name": "clang-tests"
        },
        {
          "type": "build",
          "name": "clang-tests"
        },
        {
          "type": "test",
          "name": "clang-tests"
        }
      ]
    },
    {
      "name": "sanitize",
      "displayName": "ASan/UBSan workflow",
      "steps": [
        {
          "type": "configure",
          "name": "clang-asan-ubsan"
        },
        {
          "type": "build",
          "name": "clang-asan-ubsan"
        },
        {
          "type": "test",
          "name": "clang-asan-ubsan"
        }
      ]
    },
    {
      "name": "thread",
      "displayName": "ThreadSanitizer workflow",
      "steps": [
        {
          "type": "configure",
          "name": "clang-tsan"
        },
        {
          "type": "build",
          "name": "clang-tsan"
        },
        {
          "type": "test",
          "name": "clang-tsan"
        }
      ]
    }
  ]
}
